{
  "name": "@1to5/robotevents-api-client",
  "version": "0.1.4",
  "description": "A JavaScript wrapper for the RoboEvents API with caching and pagination support",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./src/types.d.ts"
    }
  },
  "files": [
    "src/",
    "README.md"
  ],
  "keywords": [
    "robotevents",
    "api",
    "vex",
    "robotics"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1to5/robotevents-api-client.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --env-file=.env node_modules/.bin/vitest run test/integration.test.js",
    "test:ui": "vitest --ui",
    "example": "node --env-file=.env examples/usage.js",
    "example:simple": "node --env-file=.env examples/simple-usage.js",
    "prepublishOnly": "npm test",
    "postversion": "git push && git push --tags"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^1.6.1",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
