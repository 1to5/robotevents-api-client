# RobotEvents API Configuration
# Get your token from: https://www.robotevents.com/api/v2

# Your RobotEvents API Bearer Token
ROBOTEVENTS_TOKEN=your_bearer_token_here

# Optional: Custom API base URL (defaults to https://www.robotevents.com/api/v2)
# ROBOTEVENTS_BASE_URL=https://www.robotevents.com/api/v2

# Optional: Custom cache timeout in milliseconds (defaults to 300000 = 5 minutes)
# ROBOTEVENTS_CACHE_TIMEOUT=300000